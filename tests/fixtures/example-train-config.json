    "script": ".github/scripts/select-ci-lanes.py",
    "rules": ".github/ci-lanes.json"
  },
  "claude_weekly_reset": "Thu 12:00 America/New_York",
  "state_dir_name": "example-coord",
  "keychain_service": "example-coord-github-app"
